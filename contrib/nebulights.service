# systemd user service. Enable with:
#   systemctl --user enable --now nebulights.service
# (if you built from source without a package, first copy this file
#  to ~/.config/systemd/user/)
#
# Log, including the frame meter:
#   journalctl --user -u nebulights -f

[Unit]
Description=nebulights screensaver
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=nebulights -t 300
Restart=on-failure
RestartSec=5

# Uncomment to log frame statistics to the journal:
#Environment=NEBULIGHTS_STATS=1

[Install]
WantedBy=graphical-session.target
